<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.jay.dao.IProductDao">

    <resultMap id="ProductResultMap" type="cn.jay.domain.po.Product">
        <id     property="id"          column="id"/>
        <result property="productId"   column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="productDesc" column="product_desc"/>
        <result property="price"       column="price"/>
        <result property="productImg" column="product_img"/>
        <result property="status"      column="status"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>


    <select id="queryProductByProductId" parameterType="string" resultMap="ProductResultMap">

        SELECT
        id,
        product_id,
        product_name,
        product_desc,
        price,
        product_img,
        status,
        create_time,
        update_time
        FROM product
        WHERE product_id = #{productId}
        AND status = 1
    </select>

    <select id="queryProductList"
            resultMap="ProductResultMap">

        SELECT
        id,
        product_id,
        product_name,
        product_desc,
        price,
        product_img,
        status,
        create_time,
        update_time
        FROM product
        WHERE status = 1
        ORDER BY create_time DESC
    </select>

</mapper>
